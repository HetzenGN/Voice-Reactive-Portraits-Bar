{
  "manifest_version": 3,
  "name": "Voice Reactive Portraits Bar Companion",
  "version": "0.3.1",
  "description": "Relays Discord StreamKit voice activity, user discovery, and connection health to Voice Reactive Portraits Bar.",
  "minimum_chrome_version": "111",

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "homepage_url": "https://github.com/HetzenGN/Foundry-VTT-Max-Headroom",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Voice Reactive Portraits Bar Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://streamkit.discord.com/overlay/voice/*"
      ],
      "js": [
        "streamkit-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://streamkit.discord.com/overlay/voice/*"
      ],
      "js": [
        "streamkit-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}